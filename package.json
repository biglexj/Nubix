{
  "name": "nubix",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "icons:generate": "node scripts/icons/generate-icons.mjs",
    "clean:target": "cargo clean --manifest-path src-tauri/Cargo.toml",
    "sweep": "cargo sweep --installed src-tauri",
    "sweep:time": "cargo sweep --time 14 src-tauri",
    "sweep:max": "cargo sweep --maxsize 5GB src-tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
